{
  "openapi": "3.1.0",
  "info": {
    "title": "GTM Alpha API",
    "description": "EPIC framework audit endpoint of GTM Alpha",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://gtmalpha.netlify.app/api"
    }
  ],
  "paths": {
    "/epic-audit": {
      "post": {
        "operationId": "runEPICAudit",
        "summary": "EPIC framework maturity audit",
        "description": "Scores Ecosystem, Product-Led, Inbound and Outbound, and Community maturity and returns a 6-month roadmap. The inputs are saved with the result in GTM Alpha's database (Netlify Blobs store epic-audits); see https://gtmalpha.netlify.app/privacy. Limited to 30 requests per minute per IP address.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "company"
                ],
                "properties": {
                  "company": {
                    "type": "string",
                    "description": "Company name"
                  },
                  "company_id": {
                    "type": "string",
                    "description": "Optional tracking ID; defaults to the company name in lower case with dashes"
                  },
                  "industry": {
                    "type": "string",
                    "description": "Industry"
                  },
                  "company_stage": {
                    "type": "string",
                    "description": "Company stage, for example seed, series-a, growth"
                  },
                  "current_gtm": {
                    "type": "string",
                    "description": "Description of the current go-to-market approach"
                  },
                  "focus_areas": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Areas to focus on"
                  },
                  "current_metrics": {
                    "type": "object",
                    "description": "Optional current metrics"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audit results"
          },
          "400": {
            "description": "Missing required field company"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    }
  }
}
