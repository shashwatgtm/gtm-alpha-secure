{
  "function_declarations": [
    {
      "name": "gtm_consultation",
      "description": "Get GTM strategy consultation using Shashwat Ghosh EPIC framework",
      "parameters": {
        "type": "object",
        "properties": {
          "company_name": {
            "type": "string",
            "description": "Company name"
          },
          "gtm_challenge": {
            "type": "string",
            "description": "Your GTM challenge"
          },
          "business_stage": {
            "type": "string",
            "description": "Stage: seed, series-a, growth, enterprise"
          },
          "industry": {
            "type": "string",
            "description": "Your industry"
          }
        },
        "required": [
          "gtm_challenge"
        ]
      }
    },
    {
      "name": "epic_audit",
      "description": "Get EPIC framework scores for your GTM strategy",
      "parameters": {
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Describe your GTM situation"
          },
          "industry": {
            "type": "string",
            "description": "Your industry"
          },
          "business_stage": {
            "type": "string",
            "description": "Business stage"
          }
        },
        "required": [
          "challenge"
        ]
      }
    },
    {
      "name": "generate_roadmap",
      "description": "Generate a GTM implementation roadmap",
      "parameters": {
        "type": "object",
        "properties": {
          "primary_focus": {
            "type": "string",
            "enum": [
              "E",
              "P",
              "I",
              "C"
            ],
            "description": "EPIC component"
          },
          "timeframe": {
            "type": "string",
            "enum": [
              "30-day",
              "60-day",
              "90-day"
            ],
            "description": "Timeframe"
          }
        },
        "required": [
          "primary_focus"
        ]
      }
    }
  ],
  "api_endpoint": "https://gtmalpha.gtmhelix.com/mcp-sse",
  "protocol": "MCP Streamable HTTP: POST JSON-RPC 2.0 requests (initialize, tools/list, tools/call) to api_endpoint"
}
