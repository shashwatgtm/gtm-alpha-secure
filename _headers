# Security headers for every published page and file (run 5, 25 September 2026), matching the other connectors.
# The pages load scripts only from this site (assets/js); style-src allows inline styles because the pages use style blocks.
# The report returned by /api/premium-audit sets its own, stricter policy (netlify/lib/premium-audit.js).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Run 9 D4: caching. Every /assets/ address in the published pages carries ?v=<content hash> (scripts/build-site.mjs), so
# assets can be kept for a year; the pages themselves are checked again on every visit. The page rules are listed by path
# (not /*) so no Cache-Control value is merged with the /assets/* one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

